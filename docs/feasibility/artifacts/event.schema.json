{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiez-events-atlas.example/schemas/event.schema.json",
  "title": "Kiez Events Atlas – public event record",
  "description": "PRELIMINARY. Public output only. Internal confidence/review/extraction metadata lives in review_queue.json and sources.json, never here.",
  "type": "object",
  "required": [
    "event_id", "title", "start_datetime", "timezone", "venue_id", "venue_name",
    "lor_id", "category", "price_status", "price_currency", "original_event_url",
    "source_url", "observed_at", "extraction_method", "event_status", "source_freshness"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[a-z0-9]{16}$",
      "description": "Stable hash of (venue_id, original_event_url || normalized title, occurrence start date). Never derived from array position."
    },
    "series_id": {
      "type": ["string", "null"],
      "description": "Groups occurrences of a recurring series. Occurrences stay separate records."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "description": { "type": ["string", "null"], "maxLength": 4000 },
    "start_datetime": { "type": "string", "format": "date-time" },
    "end_datetime": { "type": ["string", "null"], "format": "date-time" },
    "timezone": { "const": "Europe/Berlin" },
    "venue_id": { "type": "string" },
    "venue_name": { "type": "string" },
    "lor_id": {
      "type": "string",
      "pattern": "^[0-9]{6}$",
      "description": "6-digit LOR Bezirksregion id. Keyed on id, never on name (two BZR are named 'Heerstraße')."
    },
    "lor_name": { "type": "string" },
    "category": {
      "enum": ["community_meal", "neighbourhood_gathering", "repair_cafe", "sustainability",
               "arts_culture", "neighbourhood_festival", "language_exchange",
               "civic_participation", "sport_outdoor", "participatory_workshop", "other_review"]
    },
    "price_status": {
      "enum": ["free", "donation", "fixed", "range", "unknown"],
      "description": "'unknown' is NOT free. Unknown-price events require review before publication."
    },
    "price_amount": { "type": ["number", "null"], "minimum": 0 },
    "price_amount_max": { "type": ["number", "null"], "minimum": 0 },
    "price_currency": { "const": "EUR" },
    "price_note": { "type": ["string", "null"], "maxLength": 200 },
    "original_event_url": { "type": "string", "format": "uri" },
    "source_url": { "type": "string", "format": "uri" },
    "observed_at": { "type": "string", "format": "date-time" },
    "verified_at": { "type": ["string", "null"], "format": "date-time" },
    "extraction_method": {
      "enum": ["tec_rest_v1", "tec_ics", "wp_rest_acf", "mec_jsonld", "jsonld",
               "simcal_microdata", "microdata", "em_html", "rss", "ics",
               "html_listing", "playwright"]
    },
    "extraction_evidence": {
      "type": "string",
      "maxLength": 500,
      "description": "Short human-checkable pointer, e.g. 'REST event id 3138' or 'itemprop=startDate content attr'."
    },
    "event_status": { "enum": ["scheduled", "postponed", "cancelled", "unknown"] },
    "source_freshness": {
      "enum": ["fresh", "aging", "stale"],
      "description": "fresh < 2x fetch_interval_hours, aging < 4x, stale beyond."
    },
    "language": { "enum": ["de", "en", "other"] }
  }
}
